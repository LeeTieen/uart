# Windows + GNU Make + PowerShell + QuestaSim trong PATH.
# Source/config tinh tu project; vlog/vsim/vcover chay trong sim/.
.DEFAULT_GOAL := all
SHELL := cmd.exe
.SHELLFLAGS := /D /C
.NOTPARALLEL:

ifeq ($(wildcard config.mk),)
$(error Missing config.mk. Run make in the project directory or use make -C project)
endif
include config.mk

# Co dinh cau truc thu muc de duong dan ../ trong file list nhat quan.
COMPILE_FILE := compile.f
TB_COMPILE_FILE := compile_tb.f
PS := powershell.exe -NoProfile -NonInteractive -Command
VLOG_COMMON = -sv +incdir+../rtl +incdir+../tb +incdir+../tc $(UVM_VLOG_OPT) $(VLOG_FLAGS)

ifeq ($(USE_UVM),1)
UVM_VLOG_OPT = -L $(UVM_LIB_NAME) "+incdir+../$(UVM_HOME)/src"
UVM_VSIM_OPT = -L $(UVM_LIB_NAME)
else ifeq ($(USE_UVM),0)
UVM_VLOG_OPT :=
UVM_VSIM_OPT :=
else
$(error USE_UVM must be 0 or 1)
endif

.PHONY: all all_cov all_wave all_mem init prepare_dirs gen_filelist check_uvm setup_lib check_work check_coverage build build_tb build_cov run run_cov wave mem gen_cov gen_html clean help

all: build run
all_cov: build_cov run_cov
all_wave: build run wave
all_mem: build mem

prepare_dirs:
	@$(PS) "$$ErrorActionPreference = 'Stop'; foreach ($$dir in @('rtl','tb','tc','sim/log')) { New-Item -ItemType Directory -Path $$dir -Force | Out-Null }"

# Sinh sau khi init da di chuyen source; khong quet wildcard o luc parse Makefile.
# File list chi chua duong dan tuong doi voi sim/, moi file mot dong.
define WRITE_FILELISTS
$(PS) "$$ErrorActionPreference = 'Stop'; $$rtl = @('$(RTL_SOURCES)' -split '\s+' | Where-Object { $$_ }); if ($$rtl.Count -eq 0) { if (Test-Path -LiteralPath 'rtl') { $$rtl = @(Get-ChildItem -LiteralPath 'rtl' -File | Where-Object { $$_.Extension -in '.v','.sv' } | Sort-Object Name | ForEach-Object { 'rtl/' + $$_.Name }) }; if ($$rtl.Count -eq 0) { $$rtl = @('rtl/$(TOP_MODULE).sv') } }; $$tb = @('$(TB_SOURCES)' -split '\s+' | Where-Object { $$_ }); foreach ($$p in @($$rtl) + @($$tb)) { if ([IO.Path]::IsPathRooted($$p)) { throw ('Use a relative source path: ' + $$p) } }; $$header = '// Generated by make. Paths are relative to sim/; edit config.mk to change sources.'; $$tbLines = @($$header) + @($$tb | ForEach-Object { [string][char]34 + '../' + $$_ + [string][char]34 }); $$fullLines = @($$header) + @((@($$rtl) + @($$tb)) | ForEach-Object { [string][char]34 + '../' + $$_ + [string][char]34 }); $$enc = New-Object System.Text.UTF8Encoding($$false); [IO.File]::WriteAllLines((Join-Path (Get-Location).Path '$(COMPILE_FILE)'), [string[]]$$fullLines, $$enc); [IO.File]::WriteAllLines((Join-Path (Get-Location).Path '$(TB_COMPILE_FILE)'), [string[]]$$tbLines, $$enc)"
endef

gen_filelist:
	@$(WRITE_FILELISTS)
	@echo Generated compile.f and compile_tb.f with paths relative to sim/.

# Chi init di chuyen file. Kiem tra tat ca dich truoc de khong ghi de source.
# tb_* vao tb/, tc_* vao tc/, con lai vao rtl/. Bao gom header .svh/.vh.
init: prepare_dirs
	@$(PS) "$$ErrorActionPreference = 'Stop'; $$root = (Get-Location).Path; $$prefix = $$root.TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar; $$moves = @(Get-ChildItem -LiteralPath $$root -File | Where-Object { $$_.Extension -in '.v','.sv','.vh','.svh' } | ForEach-Object { if ($$_.Name -like 'tb_*') { $$dir = 'tb' } elseif ($$_.Name -like 'tc_*') { $$dir = 'tc' } else { $$dir = 'rtl' }; [PSCustomObject]@{ Source = $$_.FullName; Destination = [IO.Path]::GetFullPath((Join-Path (Join-Path $$root $$dir) $$_.Name)) } }); foreach ($$dir in @('rtl','tb','tc')) { if ((Get-Item -LiteralPath $$dir).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw ('Refusing to move into a linked directory: ' + $$dir) } }; foreach ($$item in $$moves) { if (-not $$item.Source.StartsWith($$prefix, [StringComparison]::OrdinalIgnoreCase) -or -not $$item.Destination.StartsWith($$prefix, [StringComparison]::OrdinalIgnoreCase)) { throw 'Move outside project refused' }; if (Test-Path -LiteralPath $$item.Destination) { throw ('Destination already exists: ' + $$item.Destination) } }; foreach ($$item in $$moves) { Move-Item -LiteralPath $$item.Source -Destination $$item.Destination; Write-Host ('Moved: ' + [IO.Path]::GetFileName($$item.Source)) }"
	@$(WRITE_FILELISTS)
	@echo Init complete. Source folders and compile lists are ready.

# Chi kiem tra tool/config; khong bat license va khong compile UVM tu source.
check_uvm:
	@$(PS) "$$ErrorActionPreference = 'Stop'; foreach ($$tool in @('$(VLIB)','$(VMAP)','$(VLOG)','$(VSIM)','$(VCOVER)')) { if (-not (Get-Command $$tool -CommandType Application -ErrorAction SilentlyContinue)) { throw ('Missing tool in PATH: ' + $$tool + '. Add the QuestaSim executable directory to PATH.') } }"
ifeq ($(USE_UVM),1)
	@$(PS) "$$ErrorActionPreference = 'Stop'; foreach ($$p in @('$(UVM_HOME)','$(UVM_LIB)')) { if ([string]::IsNullOrWhiteSpace($$p) -or [IO.Path]::IsPathRooted($$p)) { throw 'Set UVM_HOME and UVM_LIB to relative paths in config.mk' } }; if (-not (Test-Path -LiteralPath '$(UVM_HOME)/src/uvm_pkg.sv')) { throw 'Missing UVM_HOME/src/uvm_pkg.sv' }; if (-not (Test-Path -LiteralPath '$(UVM_LIB)/_info')) { throw 'UVM_LIB must point to a compiled Questa library, not the UVM source folder' }"
endif
	@echo Tools/config found. USE_UVM=$(USE_UVM). License and library compatibility are checked at build/run.

setup_lib: check_uvm prepare_dirs
	@cd /d sim && if not exist modelsim.ini "$(VMAP)" -c
	@cd /d sim && if not exist work "$(VLIB)" work
	@cd /d sim && "$(VMAP)" work work
ifeq ($(USE_UVM),1)
	@cd /d sim && "$(VMAP)" $(UVM_LIB_NAME) "../$(UVM_LIB)"
endif

build: gen_filelist setup_lib
	@cd /d sim && "$(VLOG)" $(VLOG_COMMON) -f ../$(COMPILE_FILE) -l log/compile.log
	@echo Build complete. See sim/log/compile.log.

# Chi compile testbench, chua elaborate hay kiem chung DUT.
build_tb: gen_filelist setup_lib
	@cd /d sim && "$(VLOG)" $(VLOG_COMMON) -f ../$(TB_COMPILE_FILE) -l log/compile_tb.log

build_cov: gen_filelist setup_lib
	@cd /d sim && "$(VLOG)" $(VLOG_COMMON) +cover=$(COVER_TYPES) -f ../$(COMPILE_FILE) -l log/compile_cov.log
	@echo Coverage build complete. See sim/log/compile_cov.log.

# run/run_cov/mem dung thu vien da build; cap nhat file list KHONG tu build lai.
check_work: check_uvm
	@if not exist sim/work/_info (echo Missing sim/work. Run build or build_cov first. & exit /b 1)
	@if not exist sim/modelsim.ini (echo Missing sim/modelsim.ini. Run build first. & exit /b 1)

run: gen_filelist check_work
	@echo RUN: $(TB_MODULE)
	@cd /d sim && "$(VSIM)" $(UVM_VSIM_OPT) $(VSIM_FLAGS) -c -onfinish stop -l sim.log -wlf vsim.wlf -voptargs=+acc -assertdebug work.$(TB_MODULE) -do "if {[catch {log -r /*; run -all}]} {quit -f -code 1}; quit -f"

run_cov: gen_filelist check_work
	@cd /d sim && "$(VSIM)" $(UVM_VSIM_OPT) $(VSIM_FLAGS) -coverage -c -onfinish stop -l sim.log -wlf vsim.wlf -voptargs=+acc -assertdebug work.$(TB_MODULE) -do "if {[catch {coverage save -onexit coverage.ucdb; log -r /*; run -all}]} {quit -f -code 1}; quit -f"

mem: gen_filelist check_work
	@cd /d sim && "$(VSIM)" $(UVM_VSIM_OPT) $(VSIM_FLAGS) -gui -onfinish stop -voptargs=+acc -assertdebug work.$(TB_MODULE) -do "view memory; add wave -r /*; run -all"

wave: check_uvm
	@if not exist sim/vsim.wlf (echo Missing sim/vsim.wlf. Run simulation first. & exit /b 1)
	@cd /d sim && "$(VSIM)" -gui -view vsim.wlf -do "add wave -r /*; radix -$(RADIX)"

check_coverage: check_uvm
	@if not exist sim/coverage.ucdb (echo Missing sim/coverage.ucdb. Run build_cov then run_cov first. & exit /b 1)
	@$(PS) "$$ErrorActionPreference = 'Stop'; New-Item -ItemType Directory -Path 'sim/coverage' -Force | Out-Null"

gen_cov: check_coverage
	@cd /d sim && "$(VCOVER)" report -output coverage/summary_report.txt coverage.ucdb
	@cd /d sim && "$(VCOVER)" report -zeros -details -code $(COVER_TYPES) -cvg -assert -output coverage/detail_report.txt coverage.ucdb
	@echo Reports: sim/coverage/summary_report.txt and sim/coverage/detail_report.txt

gen_html: check_coverage
	@cd /d sim && "$(VCOVER)" report -html -htmldir coverage/html -testhitdataAll -code $(COVER_TYPES) -cvg -assert coverage.ucdb
	@echo HTML report: sim/coverage/html/index.html

# Chi xoa output da biet trong sim/, khong xoa source/file list.
# Kiem tra dich truoc khi xoa; dung PowerShell cho toan bo thao tac.
clean:
	@$(PS) "$$ErrorActionPreference = 'Stop'; $$root = (Get-Location).Path; $$sim = [IO.Path]::GetFullPath((Join-Path $$root 'sim')); if (-not (Test-Path -LiteralPath $$sim)) { exit 0 }; if ((Get-Item -LiteralPath $$sim).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Refusing to clean a linked sim directory' }; $$prefix = $$sim + [IO.Path]::DirectorySeparatorChar; $$targets = @('work','log','coverage','modelsim.ini','sim.log','transcript','coverage.ucdb','vsim.wlf','dump.vcd','vsim_stacktrace.vstf') | ForEach-Object { [IO.Path]::GetFullPath((Join-Path $$sim $$_)) }; foreach ($$p in $$targets) { if (-not $$p.StartsWith($$prefix, [StringComparison]::OrdinalIgnoreCase)) { throw ('Refusing to clean outside sim: ' + $$p) } }; foreach ($$p in $$targets) { if (Test-Path -LiteralPath $$p) { Remove-Item -LiteralPath $$p -Recurse -Force } }"
	@echo Simulation outputs removed. Sources and compile lists kept.

help:
	@echo CU PHAP: mingw32-make [target ...] [BIEN=gia_tri ...]
	@echo Neu may co lenh make, co the thay mingw32-make bang make.
	@echo Chay tai project hoac: mingw32-make -C duong_dan_tuong_doi target
	@echo Khong ghi target: chay all. Makefile doc cau hinh tu config.mk.
	@echo.
	@echo init       : Tao rtl/tb/tc/sim; chuyen source o root; sinh compile.f.
	@echo              tb_* vao tb/, tc_* vao tc/, con lai vao rtl/; khong ghi de.
	@echo build      : Sinh file list va compile DUT + TB; chua chay mo phong.
	@echo run        : Sinh file list va chay TB da build; KHONG tu compile lai.
	@echo all        : build roi run. Dung sau khi sua source.
	@echo check_uvm  : Kiem tra QuestaSim trong PATH; kiem tra UVM neu USE_UVM=1.
	@echo build_cov  : Compile voi code coverage; chua chay mo phong.
	@echo run_cov    : Chay ban da build_cov; luu sim/coverage.ucdb.
	@echo wave       : Mo sim/vsim.wlf cua lan chay truoc; RADIX=bin/hex/unsigned.
	@echo mem        : Chay TB da build trong GUI, mo Memory va Wave.
	@echo gen_cov    : Tao bao cao text tu coverage.ucdb vao sim/coverage/.
	@echo gen_html   : Tao sim/coverage/html/index.html tu coverage.ucdb.
	@echo clean      : Xoa output mo phong trong sim/; giu source va file list.
	@echo help       : Hien thi huong dan nay.
	@echo.
	@echo LENH BO SUNG:
	@echo build_tb   : Chi compile TB, khong elaborate DUT.
	@echo gen_filelist: Chi sinh compile.f va compile_tb.f, khong di chuyen source.
	@echo all_cov / all_wave / all_mem: Build roi chay coverage / xem wave / GUI.
	@echo.
	@echo VI DU:
	@echo   mingw32-make init
	@echo   mingw32-make all
	@echo   mingw32-make build run
	@echo   mingw32-make build_cov run_cov gen_cov gen_html
	@echo   mingw32-make wave RADIX=hex
	@echo   mingw32-make all TOP_MODULE=my_dut TB_NAME=tb_top TESTNAME=tc_pkg
	@echo   mingw32-make all USE_UVM=1 UVM_HOME=third_party/uvm-1.2 UVM_LIB=third_party/uvm_lib
	@echo.
	@echo BIEN CAU HINH:
	@echo TOP_MODULE : Ten DUT; dung lam ten RTL mac dinh khi rtl/ chua co source.
	@echo TB_NAME    : Ten module TB. TB_MODULE co the ghi de top de simulate.
	@echo TB_TOP_FILE / INTERFACE_FILE / TB_PACKAGE_FILE: Ten file trong tb/.
	@echo TESTNAME   : Ten file tc khong co .sv; KHONG chon task hay UVM test.
	@echo              TESTNAME= de bo source tc khi project khong can.
	@echo RTL_SOURCES: De trong de quet rtl/*.v, rtl/*.sv; hoac liet ke dung thu tu.
	@echo TB_SOURCES : Interface, package, tc, top. Khong lap file da duoc include.
	@echo              Source list tinh tu root; dung dau /, ten file khong co space.
	@echo VLOG_FLAGS / VSIM_FLAGS: Them tuy chon compile / simulate.
	@echo              Vi du: mingw32-make run "VSIM_FLAGS=+UVM_TESTNAME=my_test"
	@echo COVER_TYPES: b=branch c=condition e=expression s=statement f=FSM t=toggle.
	@echo.
	@echo FILE LIST: compile.f o root; duong dan ben trong tinh tu sim/.
	@echo Thu tu mac dinh: RTL, interface, TB package, TC, TB top.
	@echo Class/header duoc include khong can dong rieng trong compile.f.
	@echo Sua config.mk de doi source; file list duoc sinh lai boi init/build/run.
	@echo.
	@echo CU PHAP MAKEFILE:
	@echo include config.mk : Doc bien cau hinh tu file config.mk.
	@echo ?= : Gan mac dinh neu bien chua duoc dinh nghia.
	@echo := : Gan va tinh gia tri ngay. Dau = tinh gia tri khi bien duoc dung.
	@echo $$(BIEN) : Lay gia tri bien. BIEN=gia_tri tren command line ghi de config.
	@echo target: dependency : Chay dependency truoc recipe cua target.
	@echo Recipe bat dau bang TAB. Ky tu @ an lenh, van hien ket qua.
	@echo .PHONY : Target la lenh thao tac, khong phai ten file output.
